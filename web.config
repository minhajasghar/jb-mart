<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- Disable WebDAV module to allow PUT, DELETE, and PATCH REST API methods -->
    <modules>
      <remove name="WebDAVModule" />
    </modules>

    <!-- Register iisnode handler for server.js -->
    <handlers>
      <remove name="WebDAV" />
      <remove name="iisnode" />
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>

    <!-- iisnode configuration: explicit node.exe path, logging off (avoids permission errors) -->
    <iisnode
      nodeProcessCommandLine="&quot;C:\Program Files\nodejs\node.exe&quot;"
      loggingEnabled="false"
      devErrorsEnabled="true"
      watchedFiles="web.config;*.js"
    />

    <rewrite>
      <rules>
        <!-- Pass API requests to Express -->
        <rule name="ApiRequests" stopProcessing="true">
          <match url="^api\/" />
          <action type="Rewrite" url="server.js" />
        </rule>

        <!-- SPA fallback: any non-file request goes to server.js (React Router support) -->
        <rule name="SpaFallback">
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="True" />
          </conditions>
          <action type="Rewrite" url="server.js" />
        </rule>
      </rules>
    </rewrite>

    <!-- Pass Node.js errors through to the browser -->
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
